{
  "rules": {
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && (!data.exists() || data.child('owner').val() === auth.uid)",
        ".validate": "$code.matches(/^[A-Z2-9]{4}$/) && newData.hasChild('owner')",
        "owner": {
          ".validate": "newData.val() === auth.uid"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('owner').exists() && !root.child('rooms').child($code).child('banned').child($uid).exists()",
            ".validate": "newData.hasChildren(['name', 'duck', 'icon'])",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16" },
            "duck": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 34" },
            "icon": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 17" },
            "online": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "inputs": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('players').child($uid).exists()",
            "dx": { ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 1" },
            "dy": { ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 1" },
            "n": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
